<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>process-engine-api-adapter-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>process-engine-api-adapter-spring-boot</artifactId>
  <name>VanillaBP Process-Engine-API adapter - Spring Boot</name>
  <description>Spring Boot auto-configuration registering the Process-Engine-API adapter (mock-backed by default).</description>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>process-engine-api-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>process-engine-api-mock</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-spring-boot-integration</artifactId>
    </dependency>

    <dependency>
      <!-- reads the configuration metadata in EveryKeyIsKnownToTheIdeTest, the way tools do -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-metadata</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>vanillabp-spring-boot-support</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- the configuration processor writes META-INF/spring-configuration-metadata.json.
             An IDE reads that file to offer and check the keys in application.yaml. The
             processor merges META-INF/additional-spring-configuration-metadata.json into it,
             see decision 21 in the repository's DECISIONS.md -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths combine.children="append">
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
