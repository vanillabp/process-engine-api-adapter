<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>process-engine-api-adapter-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>process-engine-api-adapter</artifactId>
  <name>VanillaBP Process-Engine-API adapter - Core</name>
  <description>Platform-neutral adapter SPI implementations wiring VanillaBP to the bpm-crafters Process-Engine-API.</description>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp.adapter</groupId>
      <artifactId>migration-adapter-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.bpm-crafters.process-engine-api</groupId>
      <artifactId>process-engine-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
    </dependency>
    <!-- the in-memory engine this adapter ships as its BPMS double: the tests of the
         platform-neutral core run against it, and they count for BOTH platforms -->
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>process-engine-api-mock</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- the core of the platform integration: the deployment tests build the scoping
         service the platform hands to an adapter -->
    <dependency>
      <groupId>io.vanillabp.adapter</groupId>
      <artifactId>migration-adapter</artifactId>
      <version>${adapter-platform.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>test-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- 'adapter-process-engine-api.properties' carries the versions into the JAR -->
      <resource>
        <filtering>true</filtering>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
  </build>
</project>
